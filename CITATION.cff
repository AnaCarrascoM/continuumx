cff-version: 1.2.0
message: "If you use continuumx, please cite the master's thesis it accompanies."
title: "continuumx: a Python library for continuous graphs"
type: software
authors:
  - family-names: "Carrasco Martín"
    given-names: "Ana"
version: "0.1.0"
license: MIT
repository-code: "https://github.com/AnaCarrascoM/continuumx"
abstract: >-
  A Python library for continuous graphs, built on NetworkX. It computes
  distances between any two points of a continuous graph, eccentricity,
  diameter, radius and center.
keywords:
  - graph theory
  - continuous graph
  - metric graph
  - networkx
preferred-citation:
  type: thesis
  thesis-type: "Master's thesis"
  title: "Computing Distances in Combinatorial and Continuous Graphs"
  authors:
    - family-names: "Carrasco Martín"
      given-names: "Ana"
  institution:
    name: "Universidad de Sevilla"
  year: 2026
  month: 11
